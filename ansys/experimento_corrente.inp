! ============ Cargas: peso proprio pelo comprimento real de cada elemento ============
! Os nos da forma inicial NAO ficam igualmente espacados ao longo do arco
! (elementos de comprimentos diferentes). Aplicar a mesma forca em todo no (q*L/NDIV)
! distribuiria o peso por projecao, e nao por comprimento de cabo: T0 saia
! ~5% (A-P) e ~20% (C-P) acima do analitico. Aqui cada elemento leva o peso
! do seu proprio comprimento, q*le, dividido igualmente entre os 2 nos.
! (O cabo e praticamente inextensivel, entao le nao muda com a deformacao.)
FDELE,ALL,ALL
FCUM,ADD
*GET,emx,ELEM,0,NUM,MAX
*DO,e,1,emx
  n1=NELEM(e,1)
  n2=NELEM(e,2)
  *GET,sc,ELEM,e,ATTR,SECN
  le=DISTND(n1,n2)
  qe=q1
  *IF,sc,EQ,3,THEN
    qe=q2
  *ENDIF
  F,n1,FY,-qe*le/2
  F,n2,FY,-qe*le/2
*ENDDO
FCUM,REPL

FINISH

! ============ Solucao ============
/SOLU
ANTYPE,STATIC
NLGEOM,ON
AUTOTS,ON
NSUBST,200,20000,50
PIVCHECK,OFF
! Estabilizacao por amortecimento artificial, necessaria no inicio (cabo
! ainda sem tracao). REDUCE leva esse amortecimento a zero ao fim do passo
! de carga: o equilibrio final nao e afetado (conferido: ENERGY 1e-2 e 1e-1
! dao exatamente o mesmo resultado).
STABILIZE,REDUCE,ENERGY,1.0E-2
OUTRES,ALL,ALL
SOLVE
FINISH

! ============ Pos-processamento ============
/POST1
SET,LAST

*GET,uPx,NODE,nodeP,U,X
*GET,uPy,NODE,nodeP,U,Y
*GET,uPz,NODE,nodeP,U,Z

xpFinal=xp0+uPx
ypFinal=yp0+uPy
zpFinal=zp0+uPz

/OUT,resultado_noP,txt
*VWRITE,xpFinal,ypFinal,zpFinal
('NO P FINAL (x,y,z) = ',F12.5,',',F12.5,',',F12.5)
/OUT

ALLSEL,ALL
ETABLE,AXF,SMISC,1

ESEL,S,SECNUM,,1
/OUT,forcas_linha1_AP,txt
PRETAB,AXF
/OUT

ESEL,S,SECNUM,,2
/OUT,forcas_linha2_BP,txt
PRETAB,AXF
/OUT

ESEL,S,SECNUM,,3
/OUT,forcas_linha3_CP,txt
PRETAB,AXF
/OUT

! ============ T0 (tracao horizontal) nos elementos junto ao no P ============
! Elemento mais proximo de P em cada trecho: NDIV, 2*NDIV, 3*NDIV
! (numeracao sequencial de criacao por linha)
elA=NDIV
elB=2*NDIV
elC=3*NDIV

*GET,n1A,ELEM,elA,NODE,1
*GET,n2A,ELEM,elA,NODE,2
*GET,axfA,ELEM,elA,ETAB,AXF

*GET,n1B,ELEM,elB,NODE,1
*GET,n2B,ELEM,elB,NODE,2
*GET,axfB,ELEM,elB,ETAB,AXF

*GET,n1C,ELEM,elC,NODE,1
*GET,n2C,ELEM,elC,NODE,2
*GET,axfC,ELEM,elC,ETAB,AXF

*GET,ux1A,NODE,n1A,U,X
*GET,uy1A,NODE,n1A,U,Y
*GET,uz1A,NODE,n1A,U,Z
*GET,ux2A,NODE,n2A,U,X
*GET,uy2A,NODE,n2A,U,Y
*GET,uz2A,NODE,n2A,U,Z
dx=(NX(n2A)+ux2A)-(NX(n1A)+ux1A)
dy=(NY(n2A)+uy2A)-(NY(n1A)+uy1A)
dz=(NZ(n2A)+uz2A)-(NZ(n1A)+uz1A)
LenA=SQRT(dx*dx+dy*dy+dz*dz)
HorA=SQRT(dx*dx+dz*dz)
T0A=axfA*HorA/LenA

*GET,ux1B,NODE,n1B,U,X
*GET,uy1B,NODE,n1B,U,Y
*GET,uz1B,NODE,n1B,U,Z
*GET,ux2B,NODE,n2B,U,X
*GET,uy2B,NODE,n2B,U,Y
*GET,uz2B,NODE,n2B,U,Z
dx=(NX(n2B)+ux2B)-(NX(n1B)+ux1B)
dy=(NY(n2B)+uy2B)-(NY(n1B)+uy1B)
dz=(NZ(n2B)+uz2B)-(NZ(n1B)+uz1B)
LenB=SQRT(dx*dx+dy*dy+dz*dz)
HorB=SQRT(dx*dx+dz*dz)
T0B=axfB*HorB/LenB

*GET,ux1C,NODE,n1C,U,X
*GET,uy1C,NODE,n1C,U,Y
*GET,uz1C,NODE,n1C,U,Z
*GET,ux2C,NODE,n2C,U,X
*GET,uy2C,NODE,n2C,U,Y
*GET,uz2C,NODE,n2C,U,Z
dx=(NX(n2C)+ux2C)-(NX(n1C)+ux1C)
dy=(NY(n2C)+uy2C)-(NY(n1C)+uy1C)
dz=(NZ(n2C)+uz2C)-(NZ(n1C)+uz1C)
LenC=SQRT(dx*dx+dy*dy+dz*dz)
HorC=SQRT(dx*dx+dz*dz)
T0C=axfC*HorC/LenC

/OUT,resumo_T0,txt
*VWRITE,T0A,T0B,T0C
('T0,A = ',F10.3,' N   T0,B = ',F10.3,' N   T0,C = ',F10.3,' N')
/OUT

! ============ Imagem da forma deformada ============
ALLSEL,ALL
/SHOW,PNG
/VIEW,1,1,1,1
/ANG,1
/DSCALE,1,1
PLDISP,1
/SHOW,CLOSE

FINISH
