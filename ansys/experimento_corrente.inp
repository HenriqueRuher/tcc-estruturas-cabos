/CLEAR,NOSTART
/FILNAME,experimento_corrente,1
/TITLE,Experimento com correntes - mesmo modelo do Estudo de Caso 3 (TCC)
/PREP7

! ============ Parametros fisicos (experimento com correntes, Estatica_corrente.tsv) ============
! Sistema do modelo: y vertical, A e B em z = 0, em m e N/m. Passagem do Qualisys (mm):
! ver experimento/comparacao/dados_experimento.py (classe Eixos). Fixacoes A, B, C NAO medidas:
! catenaria ajustada a cada ramo, prolongada ate o comprimento medido (ajuste_ramos.py).
xa=0.00000     $ ya=1.01925    $ za=0.00000
xb=1.17106     $ yb=0.94690    $ zb=0.00000
xc=0.70093     $ yc=1.05888    $ zc=1.15094

L1=2.004
LC=1.425
eta=0.5539
LA=eta*L1
LB=(1-eta)*L1

! corrente grossa: 1,373 kg em 2,004 m; media: 0,948 kg em 2,002 m; g = 9,80665 m/s2
q1=6.718828
q2=4.643708

xp0=0.64865
yp0=0.45
zp0=0.3683

! ============ Geometria ============
K,1,xa,ya,za
K,2,xb,yb,zb
K,3,xc,yc,zc
K,4,xp0,yp0,zp0

L,1,4
L,2,4
L,3,4

! Keypoints auxiliares apenas para orientacao do BEAM188 (secao circular,
! entao a orientacao nao afeta a fisica, so precisa ser um ponto fora da linha)
K,10,xa,ya+0.2,za
K,11,xb,yb+0.2,zb
K,12,xc,yc+0.2,zc

dAP=SQRT((xp0-xa)*(xp0-xa)+(yp0-ya)*(yp0-ya)+(zp0-za)*(zp0-za))
dBP=SQRT((xp0-xb)*(xp0-xb)+(yp0-yb)*(yp0-yb)+(zp0-zb)*(zp0-zb))
dCP=SQRT((xp0-xc)*(xp0-xc)+(yp0-yc)*(yp0-yc)+(zp0-zc)*(zp0-zc))

! O excesso de comprimento (folga) e representado pela forma parabolica
! inicial dos nos (ver secao de perturbacao abaixo).

! ============ Elemento / material ============
! BEAM188: viga fina com pequena rigidez a flexao. Diferente do LINK180
! (trelica pura), uma viga reta ja possui rigidez transversal propria,
! entao nao ha singularidade de colinearidade a resolver.
ET,1,BEAM188

MP,EX,1,2.0E11
MP,PRXY,1,0.3

! Secao generica (ASEC): area de uma secao circular de raio rsec
! (EA alto -> cabo praticamente inextensivel), mas momento de inercia
! REDUZIDO pelo fator fI em relacao ao da secao circular. Com a secao
! circular macica (CSOLID) area e inercia ficam acopladas (A = pi r^2,
! I = pi r^4/4): diminuir o raio reduz EI mas tambem EA. Com ASEC os dois
! sao independentes. fI: ver estudo_rigidez_experimento.py; EI menor ainda deixa o 1o substep
! quase singular (cabo sem tracao = sem rigidez transversal).
! Usamos 3 IDs de secao identicos apenas para poder identificar depois
! (via SECNUM) a qual trecho cada elemento pertence.
! rsec e fI: mesmos EA/(q1 L1) e EI/(q1 L1^3) do caso do TCC (ver gerar_experimento_corrente.py)
rsec=0.000821
fI=0.003
Asec=3.14159265359*rsec**2
Isec=fI*3.14159265359*rsec**4/4
SECTYPE,1,BEAM,ASEC
SECDATA,Asec,Isec,0,Isec,0,2*Isec
SECTYPE,2,BEAM,ASEC
SECDATA,Asec,Isec,0,Isec,0,2*Isec
SECTYPE,3,BEAM,ASEC
SECDATA,Asec,Isec,0,Isec,0,2*Isec

! ============ Malha ============
NDIV=40

LSEL,S,LINE,,1
LATT,1,,1,,10,,1
LESIZE,1,,,NDIV

LSEL,S,LINE,,2
LATT,1,,1,,11,,2
LESIZE,2,,,NDIV

LSEL,S,LINE,,3
LATT,1,,1,,12,,3
LESIZE,3,,,NDIV

ALLSEL,ALL
LMESH,ALL

! ============ Coletar listas de nos de cada linha (ANTES do detach) ============
*DIM,nlist1,ARRAY,200
*DIM,nlist2,ARRAY,200
*DIM,nlist3,ARRAY,200

LSEL,S,LINE,,1
NSLL,S,0
*GET,nn1,NODE,0,COUNT
nid=0
*DO,i,1,nn1
  nid=NDNEXT(nid)
  nlist1(i)=nid
*ENDDO

LSEL,S,LINE,,2
NSLL,S,0
*GET,nn2,NODE,0,COUNT
nid=0
*DO,i,1,nn2
  nid=NDNEXT(nid)
  nlist2(i)=nid
*ENDDO

LSEL,S,LINE,,3
NSLL,S,0
*GET,nn3,NODE,0,COUNT
nid=0
*DO,i,1,nn3
  nid=NDNEXT(nid)
  nlist3(i)=nid
*ENDDO

ALLSEL,ALL

! ============ Nos das ancoragens e do no P ============
KSEL,S,,,1
NSLK,S
*GET,nodeA,NODE,0,NUM,MAX

KSEL,S,,,2
NSLK,S
*GET,nodeB,NODE,0,NUM,MAX

KSEL,S,,,3
NSLK,S
*GET,nodeC,NODE,0,NUM,MAX

KSEL,S,,,4
NSLK,S
*GET,nodeP,NODE,0,NUM,MAX

ALLSEL,ALL

! ============ Condicoes de contorno ============
D,nodeA,ALL,0
D,nodeB,ALL,0
D,nodeC,ALL,0

! ============ Cargas ============
! O peso proprio e aplicado mais abaixo, DEPOIS de mover os nos para a forma
! inicial, porque depende do comprimento real de cada elemento.

ALLSEL,ALL

! ============ Perturbacao inicial (quebra colinearidade) ============
! Feita apos detach da malha do modelo solido, usando somente numeros de no
! ja coletados acima (evita restricao "node attached to line").

MODMSH,DETACH

! PROPOSITAL: chute inicial RUIM = parabola pura (suave em toda a
! extensao, sem nenhum ponto anguloso), 100% dentro do plano vertical
! de cada cabo, com profundidade maior que a correta (comprimento de
! arco ainda bate com LA/LB/LC, mas a forma comeca claramente errada).

